# Telegram Bot configuration
# BotFather'dan olingan bot tokenini kiriting:
BOT_TOKEN=PASTE_YOUR_TELEGRAM_BOT_TOKEN_HERE

# Administrator Telegram ID raqamlari (masalan: 1899499264,12345678):
ADMIN_IDS=1899499264

# Veb boshqaruv paneli paroli:
ADMIN_PASSWORD=yoshtech2026

# PostgreSQL (Supabase / Neon / Render Postgres) URL (ixtiyoriy, agar bo'sh qoldirilsa avtomatik SQLite ishlatiladi):
# Misol: postgresql://postgres.xxxx:parol@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Google Gemini AI API sozlamalari
# API kalitni https://aistudio.google.com/ dan bepul olishingiz mumkin
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
